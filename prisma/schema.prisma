generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  city      String
  rating    Int
  comment   String
  date      String   @default("")
  createdAt DateTime @default(now())
}